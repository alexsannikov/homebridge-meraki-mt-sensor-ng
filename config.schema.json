{
  "pluginAlias": "MerakiMT",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "This plugin exposes Cisco Meraki MT sensors to HomeKit. Configured sensors are added to the Homebridge bridge automatically — no extra pairing is needed.",
  "footerDisplay": "This plugin works with Meraki MT devices which is available [here](https://github.com/alexsannikov/homebridge-meraki-mt-sensor-ng).",
  "schema": {
    "type": "object",
    "properties": {
      "devices": {
        "title": "Sensors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Sensor Name",
              "type": "string",
              "default": "Sensor name",
              "required": true
            },
            "host": {
              "title": "API path",
              "type": "string",
              "required": true,
              "description": "Example: https://api.meraki.com"
            },
            "apiKey": {
              "title": "API key",
              "type": "string",
              "required": true,
              "description": "Manage API Keys here: https://dashboard.meraki.com/manage/users/edit"
            },
            "organizationId": {
              "title": "Organization Id",
              "type": "string",
              "required": true,
              "description": "Find your organization: https://api.meraki.com/api/v1/organizations"
            },
            "networkId": {
              "title": "Network ID",
              "type": "string",
              "required": true,
              "description": "Find your network ID: https://api.meraki.com/api/v1/organizations/your_org_id/networks"
            },
            "type": {
              "title": "Sensor type",
              "type": "string",
              "default": "tempSensor",
              "description": "Select sensor type",
              "oneOf": [
                {
                  "title": "Temperature",
                  "const": "tempSensor"
                },
                {
                  "title": "Humidity",
                  "const": "humiditySensor"
                },
                {
                  "title": "Door",
                  "const": "doorSensor"
                },
                {
                  "title": "Quality/PM2.5/VOC",
                  "const": "qualitySensor"
                },
                {
                  "title": "CO2",
                  "const": "co2Sensor"
                }
              ],
              "required": true
            },
            "refreshInterval": {
              "title": "Refresh interval (sec)",
              "type": "integer",
              "default": 60,
              "minimum": 5,
              "maximum": 3600,
              "required": false,
              "description": "Change the refresh interval, lower values may be beneficial for door sensors"
            },
            "serial": {
              "title": "Serial Number",
              "type": "string",
              "description": "Set the serial number of the sensor",
              "required": true
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "devices",
      "type": "tabarray",
      "title": "{{ value.name || 'new device' }}",
      "items": [
        "devices[].name",
        "devices[].host",
        "devices[].apiKey",
        "devices[].organizationId",
        "devices[].networkId",
        "devices[].type",
        "devices[].serial",
        {
          "key": "devices[]",
          "type": "section",
          "title": "Advanced Settings",
          "expandable": true,
          "expanded": false,
          "items": ["devices[].refreshInterval"]
        }
      ]
    }
  ]
}
